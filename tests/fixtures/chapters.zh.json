      "entry": "p0-intro",
      "nodes": [
        {
          "id": "p0-intro",
          "type": "dialogue",
          "speaker_key": "narrator",
          "initial": "序",
          "accent": "narrator",
          "next": "p0-ai",
          "speaker": "旁白",
          "text": "整座校园竞技场在三秒内黑了下来。观众席上还有人在鼓掌，以为这是演出的一部分。你打开终端，天穹的报告弹出来：能源供应正常。"
        },
        {
          "id": "p0-ai",
          "type": "dialogue",
          "speaker_key": "terminal",
          "initial": "穹",
          "accent": "terminal",
          "palette": {
            "main": "#7cd4ff",
            "light": "#dff3ff",
            "dark": "#1b4a66"
          },
          "next": "p0-choice",
          "speaker": "天穹",
          "text": "检测到异常物品。根据数据库，您刚刚找到的物品不存在。请放下它。"
        },
        {
          "id": "p0-choice",
          "type": "choice",
          "prompt_key": "prompt",
          "options": [
            {
              "id": "ask",
              "next": "p0-ai-ask",
              "label": "那我手里这个是什么？"
            },
            {
              "id": "fix",
              "next": "p0-ai-fix",
              "label": "先别管它，把电修好。"
            }
          ],
          "prompt": "终端等着你回答。观众席开始骚动。"
        },
        {
          "id": "p0-ai-ask",
          "type": "dialogue",
          "speaker_key": "terminal",
          "initial": "穹",
          "accent": "terminal",
          "palette": {
            "main": "#7cd4ff",
            "light": "#dff3ff",
            "dark": "#1b4a66"
          },
          "next": "p0-battle",
          "speaker": "天穹",
          "text": "建议您停止持有不存在的物品。重复：建议您停止持有不存在的物品。"
        },
        {
          "id": "p0-ai-fix",
          "type": "dialogue",
          "speaker_key": "terminal",
          "initial": "穹",
          "accent": "terminal",
          "palette": {
            "main": "#7cd4ff",
            "light": "#dff3ff",
            "dark": "#1b4a66"
          },
          "next": "p0-battle",
          "speaker": "天穹",
          "text": "能源供应正常。因此，停电不成立。既然停电不成立，您看到的黑暗属于视觉误差。"
        },
        {
          "id": "p0-battle",
          "type": "battle",
          "battle": {
            "hero": null,
            "target_waves": 2,
            "map_theme": "school"
          },
          "on_win": "p0-reward",
          "on_lose": "p0-battle",
          "title": "配电间",
          "brief": "维修机器人全部离线，但它们的动作没有停。清掉两波，才能继续查。",
          "waves": [
            {
              "label": "波次 1",
